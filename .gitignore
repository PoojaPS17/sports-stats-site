# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local embedded postgres data
/.pgdata

# typescript
*.tsbuildinfo
next-env.d.ts

# sha the VM last built and started (deploy/vm/autodeploy.sh)
.deployed.sha
# swap directories and the build checkout's stamps (deploy/vm/autodeploy.sh)
.next.prev/
.next.failed/
.next-cache/
node_modules.prev/
node_modules.failed/
.npm-ci.lock-cksum
